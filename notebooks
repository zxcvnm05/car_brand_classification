        "# SECTION 5: DATA PREPROCESSING\n",
        "def preprocess(df: pd.DataFrame, target_col: str):\n",
        "    \"\"\"\n",
        "    Encode categoricals, scale numerics, split into train/test.\n",
        "    Returns X_train, X_test, y_train, y_test, feature_names, le_target.\n",
        "    \"\"\"\n",
        "    print(\"\\n\" + \"=\" * 60)\n",
        "    print(\"DATA PREPROCESSING\")\n",
        "    print(\"=\" * 60)\n",
        "\n",
        "    # 1. Tạo bản sao để tránh ghi đè dữ liệu gốc\n",
        "    df_encoded = df.copy()\n",
        "\n",
        "    # 2. Loại bỏ các cột định danh không mang giá trị dự báo để tránh nhiễu/lỗi hệ thống\n",
        "    unnecessary_cols = ['Car_id', 'Customer Name', 'Phone', 'Dealer_No', 'Dealer_Name']\n",
        "    df_encoded.drop(columns=[col for col in unnecessary_cols if col in df_encoded.columns], inplace=True)\n",
        "\n",
        "    # 3. Mã hóa biến mục tiêu (Target) - hãng xe 'Company'\n",
        "    le_target = LabelEncoder()\n",
        "    y_raw = df_encoded[target_col].astype(str).str.strip()\n",
        "    y = le_target.fit_transform(y_raw)\n",
        "    print(f\"  Target classes : {len(le_target.classes_)}\")\n",
        "\n",
        "    # 4. Xác định danh sách các đặc trưng cần loại bỏ khỏi X bao gồm Target và 'Model' (Tránh Data Leakage)\n",
        "    columns_to_drop = [target_col, 'Model']\n",
        "    columns_to_drop = [col for col in columns_to_drop if col in df_encoded.columns]\n",
        "\n",
        "    # Tạo ma trận tính năng X độc lập\n",
        "    X = df_encoded.drop(columns=columns_to_drop)\n",
        "\n",
        "    # 5. Mã hóa CÁC BIẾN PHÂN LOẠI CÒN LẠI trong X thành dạng số (Sửa lỗi \"could not convert string to float\")\n",
        "    cat_cols = X.select_dtypes(include=\"object\").columns.tolist()\n",
        "    le_map = {}\n",
        "    for col in cat_cols:\n",
        "        le = LabelEncoder()\n",
        "        X[col] = le.fit_transform(X[col].astype(str).str.strip())\n",
        "        le_map[col] = le\n",
        "    print(f\"  Categorical columns label-encoded : {len(cat_cols)}\")\n",
        "\n",
        "    # Bước 6: Split TRƯỚC\n",
        "    X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X, y, test_size=0.20, random_state=42, stratify=y\n",
        "    )\n",
        "\n",
        "    # Bước 7: Sau đó mới scale — fit chỉ trên X_train\n",
        "    num_cols = X_train.select_dtypes(include=[np.number]).columns.tolist()\n",
        "    scaler = StandardScaler()\n",
        "    X_train[num_cols] = scaler.fit_transform(X_train[num_cols])\n",
        "    X_test[num_cols]  = scaler.transform(X_test[num_cols])\n",
        "    feature_names = X_train.columns.tolist()\n",
        "\n",
        "\n",
        "    return X_train, X_test, y_train, y_test, feature_names, le_target"
      ]
    },
