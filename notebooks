        "# SECTION 7: MODEL EVALUATION\n",
        "def evaluate_models(trained: dict, X_test, y_test) -> pd.DataFrame:\n",
        "    \"\"\"Compute Accuracy / Precision / Recall / F1 for all models.\"\"\"\n",
        "    print(\"\\n\" + \"=\" * 60)\n",
        "    print(\"MODEL EVALUATION\")\n",
        "    print(\"=\" * 60)\n",
        "\n",
        "    results = []\n",
        "    avg = \"weighted\"\n",
        "\n",
        "    for name, model in trained.items():\n",
        "        y_pred = model.predict(X_test)\n",
        "        results.append({\n",
        "            \"Model\":     name,\n",
        "            \"Accuracy\":  round(accuracy_score(y_test, y_pred),  4),\n",
        "            \"Precision\": round(precision_score(y_test, y_pred, average=avg, zero_division=0), 4),\n",
        "            \"Recall\":    round(recall_score(y_test, y_pred, average=avg, zero_division=0), 4),\n",
        "            \"F1 Score\":  round(f1_score(y_test, y_pred, average=avg, zero_division=0), 4),\n",
        "        })\n",
        "\n",
        "    results_df = pd.DataFrame(results).sort_values(\"Accuracy\", ascending=False)\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 50 + \" MODEL COMPARISON\")\n",
        "    print(results_df.to_string(index=False))\n",
        "\n",
        "    return results_df"
      ]
