        "# SECTION 8: HYPERPARAMETER TUNING\n",
        "def tune_models(X_train, y_train, X_test, y_test) -> tuple:\n",
        "    \"\"\"\n",
        "    GridSearchCV for Random Forest and XGBoost.\n",
        "    Returns (best_model_name, best_model, best_params).\n",
        "    \"\"\"\n",
        "    print(\"\\n\" + \"=\" * 60)\n",
        "    print(\"HYPERPARAMETER TUNING  (GridSearchCV – 5-fold CV)\")\n",
        "    print(\"=\" * 60)\n",
        "\n",
        "    cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
        "\n",
        "    # --- Random Forest grid ---\n",
        "    rf_grid = {\n",
        "        \"n_estimators\":      [100, 200],\n",
        "        \"max_depth\":         [None, 10, 20],\n",
        "        \"min_samples_split\": [2, 5],\n",
        "    }\n",
        "    print(\"\\n  Tuning Random Forest …\")\n",
        "    rf_search = GridSearchCV(\n",
        "        RandomForestClassifier(random_state=42, n_jobs=-1),\n",
        "        rf_grid, cv=cv, scoring=\"accuracy\", n_jobs=-1, verbose=0\n",
        "    )\n",
        "    rf_search.fit(X_train, y_train)\n",
        "    rf_best_score = rf_search.best_score_\n",
        "    print(f\"    Best CV Accuracy : {rf_best_score:.4f}\")\n",
        "    print(f\"    Best Params      : {rf_search.best_params_}\")\n",
        "\n",
        "    # --- XGBoost grid ---\n",
        "    xgb_grid = {\n",
        "        \"n_estimators\": [100, 200],\n",
        "        \"max_depth\":    [4, 6],\n",
        "        \"learning_rate\": [0.05, 0.1],\n",
        "    }\n",
        "    print(\"\\n  Tuning XGBoost …\")\n",
        "    xgb_search = GridSearchCV(\n",
