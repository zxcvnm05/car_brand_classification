        "# SECTION 3: DATA CLEANING\n",
        "def clean_dataset(df: pd.DataFrame) -> pd.DataFrame:\n",
        "    \"\"\"Remove duplicates, handle missing values, fix data types.\"\"\"\n",
        "    print(\"\\n\" + \"=\" * 60)\n",
        "    print(\"DATA CLEANING\")\n",
        "    print(\"=\" * 60)\n",
        "\n",
        "    # --- 3a. Remove duplicates ---\n",
        "    before = len(df)\n",
        "    df = df.drop_duplicates()\n",
        "    after = len(df)\n",
        "    print(f\"  Duplicates removed : {before - after:,} rows\")\n",
        "\n",
        "    # --- 3b. Standardise column names (strip whitespace, title-case) ---\n",
        "    df.columns = df.columns.str.strip()\n",
        "\n",
        "    # --- 3c. Parse 'Date' column if present ---\n",
        "    date_cols = [c for c in df.columns if \"date\" in c.lower()]\n",
        "    for col in date_cols:\n",
        "        df[col] = pd.to_datetime(df[col], errors=\"coerce\")\n",
        "        df[f\"{col}_Year\"]  = df[col].dt.year\n",
        "        df[f\"{col}_Month\"] = df[col].dt.month\n",
        "        df[f\"{col}_Day\"]   = df[col].dt.day\n",
        "        df.drop(columns=[col], inplace=True)\n",
        "        print(f\"  '{col}' decomposed into Year/Month/Day features.\")\n",
        "\n",
        "    # --- 3d. Clean currency / numeric strings (e.g. \"$12,500\") ---\n",
        "    for col in df.select_dtypes(include=\"object\").columns:\n",
        "        sample = df[col].dropna().head(200).astype(str)\n",
        "        looks_numeric = sample.str.replace(r\"[\\$,\\s]\", \"\", regex=True).str.match(\n",
        "            r\"^-?\\d+\\.?\\d*$\"\n",
        "        ).mean()\n",
        "        if looks_numeric > 0.8:\n",
        "            df[col] = (\n",
        "                df[col].astype(str)\n",
        "                .str.replace(r\"[\\$,\\s]\", \"\", regex=True)\n",
        "                .replace(\"nan\", np.nan)\n",
        "            )\n",
        "            df[col] = pd.to_numeric(df[col], errors=\"coerce\")\n",
        "            print(f\"  '{col}' converted from string to numeric.\")\n",
        "\n",
        "    # --- 3e. Handle missing values ---\n",
        "    num_cols = df.select_dtypes(include=[np.number]).columns.tolist()\n",
        "    cat_cols = df.select_dtypes(include=\"object\").columns.tolist()\n",
        "\n",
        "    for col in num_cols:\n",
        "        if df[col].isnull().sum() > 0:\n",
        "            median_val = df[col].median()\n",
        "            df[col].fillna(median_val, inplace=True)\n",
        "            print(f\"  '{col}' – filled {df[col].isnull().sum()} NaN with median ({median_val:.2f})\")\n",
        "\n",
        "    for col in cat_cols:\n",
        "        if df[col].isnull().sum() > 0:\n",
        "            mode_val = df[col].mode()[0]\n",
        "            df[col].fillna(mode_val, inplace=True)\n",
        "            print(f\"  '{col}' – filled NaN with mode ('{mode_val}')\")\n",
        "\n",
        "    print(f\"\\n  Cleaned dataset shape : {df.shape[0]:,} rows x {df.shape[1]} columns\")\n",
        "    return df"
      ]
    },
