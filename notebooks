        "# MAIN ENTRY POINT\n",
        "def main():\n",
        "    # ── Path configuration ───────────────────────────────────────────────────\n",
        "    CSV_PATH   = \"car_sales.csv\"\n",
        "    TARGET_COL = \"Company\"\n",
        "    # 1. Load\n",
        "    df = load_dataset(CSV_PATH)\n",
        "\n",
        "    # 2. Clean\n",
        "    df = clean_dataset(df)\n",
        "\n",
        "    # Confirm target column exists\n",
        "    if TARGET_COL not in df.columns:\n",
        "        available = \", \".join(df.columns.tolist())\n",
        "        raise ValueError(\n",
        "            f\"Target column '{TARGET_COL}' not found.\\n\"\n",
        "            f\"Available columns: {available}\\n\"\n",
        "            f\"Update TARGET_COL at the top of main().\"\n",
        "        )\n",
        "\n",
        "    # 3. Preprocess\n",
        "    X_train, X_test, y_train, y_test, feature_names, le_target = preprocess(\n",
        "        df, TARGET_COL\n",
        "    )\n",
        "     # 4. EDA\n",
        "    run_eda(df)\n",
        "\n",
        "    # 5. Train baseline models\n",
        "    models  = build_models()\n",
        "    trained = train_all_models(models, X_train, y_train)\n",
        "\n",
        "    # 6. Evaluate baselines\n",
        "    results_df = evaluate_models(trained, X_test, y_test)\n",
        "\n",
        "    # 7. Hyperparameter tuning\n",
        "    best_name, best_model, best_params = tune_models(\n",
        "        X_train, y_train, X_test, y_test\n",
        "    )\n",
        "\n",
        "    # 8. Feature importance\n",
        "    plot_feature_importance(best_model, feature_names, best_name)\n",
        "\n",
        "    # 9. Final evaluation\n",
        "    final_evaluation(best_name, best_model, best_params, X_test, y_test, le_target)\n",
        "\n",
        "    # 10. Conclusion\n",
        "    y_pred_final = best_model.predict(X_test)\n",
        "    final_acc    = accuracy_score(y_test, y_pred_final)\n",
        "    print_conclusion(results_df, best_name, final_acc)\n",
        "\n",
        "    print(\"\\n✓ Pipeline complete.  All charts saved to the 'output/' folder.\\n\")\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
      ]
